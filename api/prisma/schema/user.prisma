model User {
  id                   String     @id @default(uuid())
  email                String     @unique
  role                 UserRole   @default(UTILIZADOR)
  firstName            String?
  lastName             String?
  phone                String?
  birthDate            DateTime?
  province             Province?
  city                 String?
  neighborhood         String?
  password             String
  passwordChangedAt    DateTime?
  lastLoginAt          DateTime?
  isSuperUser          Boolean    @default(false)
  isStaff              Boolean    @default(false)
  deletedSelfAccountAt DateTime?
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  notifications Notification[]

  triages Triage[]

  triageAnalyzedBy Triage[] @relation("TriageAnalyzedBy")

  appointments Appointment[] @relation("PatientAppointments")
}
enum UserRole {
  UTILIZADOR
  ADMINISTRADOR
  RECEPCIONISTA
  // change or add new roles
}

enum Province {
  MAPUTO
  XAI_XAI
  INHAMBANE
  SOFALA
  MANICA
  TETE
  ZAMBEZIA
  NAMPULA
  NIASSA
  CABO_DELGADO
}
