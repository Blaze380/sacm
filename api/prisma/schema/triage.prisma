model Triage {
  id                  String            @id @default(uuid())
  complaint           String
  symptomDuration     String
  symptom             String
  actionTaken         String
  reactionAfterAction String
  status              TriageStatus      @default(PENDENTE)
  patientId           String
  patient             User              @relation(fields: [patientId], references: [id])
  analyzedById        String?
  analyzedBy          User?             @relation("TriageAnalyzedBy", fields: [analyzedById], references: [id])
  specialtyId         String?
  specialty           Specialty?        @relation(fields: [specialtyId], references: [id])
  consultationTypeId  String?
  consultationType    ConsultationType? @relation(fields: [consultationTypeId], references: [id])
  priority            PriorityLevel?
  rejectionReason     String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  appointments Appointment[]
}

enum TriageStatus {
  PENDENTE
  EM_ANALISE
  CANCELADO
  REENCAMINHADO
}
