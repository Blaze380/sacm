model Doctor {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  email        String?
  availability Json?
  specialtyId  String
  specialty    Specialty @relation(fields: [specialtyId], references: [id])
  appointments Appointment[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
